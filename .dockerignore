# Tool caches
**/__pycache__
**/.ruff_cache/
**/.mypy_cache/
# Virtual environment & similar
.venv/
./src-ui/node_modules
./src-ui/dist
# IDE folders
.idea/
.vscode/
./src-ui/.vscode
# VCS
.git
# Test related
**/.pytest_cache
**/tests
**/*.spec.ts
**/htmlcov
# Local folders
./export
./consume
./media
./data
./docs
./dist
./scripts
./resources
# Other stuff
**/*.drawio.png
# Frontend caches (the Angular cache alone is >1GB and made every build slow)
./src-ui/.angular
./src-ui/.pnpm-store
./src-ui/e2e
# Local compose runtime data and secrets: never part of the image
./docker/compose/.env*
./docker/compose/data
./docker/compose/media
./docker/compose/consume
./docker/compose/export
./static
