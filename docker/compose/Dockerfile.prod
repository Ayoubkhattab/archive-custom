# ─── Stage 1: Build Angular Frontend ───────────────────────────────────────────
# Build context must be the project root:
#   docker compose -f docker/compose/docker-compose.prod.yml build
FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 make g++ pkg-config \
      libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev && \
    rm -rf /var/lib/apt/lists/* && \
    corepack enable && \
    corepack prepare pnpm@10.17.1 --activate

# Install dependencies first, in their own layer, so source-only edits
# (the common case) don't invalidate the pnpm install layer.
COPY src-ui/package.json src-ui/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY src-ui/ .
RUN npx ng build --output-path /frontend-build/ --configuration production

# ─── Stage 2: Production Image ─────────────────────────────────────────────────
FROM ghcr.io/paperless-ngx/paperless-ngx:latest

# Install Arabic OCR language pack
RUN apt-get update && \
    apt-get install -y --no-install-recommends tesseract-ocr-ara && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# The default PyPI torch wheel is built for CUDA and drags in ~9GB of nvidia-*
# libraries. The server has no GPU, so install the CPU build first; the
# packages below then see torch as already satisfied.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install custom Python packages
# whoosh-reloaded is pinned explicitly: it's a core paperless-ngx dependency
# (used for search indexing) but the upstream base image's ":latest" tag has
# been observed missing it depending on when/where it was pulled.
RUN pip install --no-cache-dir \
    llama-index-core \
    llama-index-llms-ollama \
    llama-index-embeddings-huggingface \
    llama-index-embeddings-openai \
    llama-index-vector-stores-faiss \
    faiss-cpu \
    granian \
    "whoosh-reloaded>=2.7.5" \
    django-celery-results

# Bake the default embedding model into the image so the first chat question
# doesn't download it (and so it works without outbound access to Hugging Face).
# Threads are capped so torch doesn't fight Ollama for the same CPU cores.
ENV HF_HOME=/opt/hf-cache \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=2
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')" && \
    chmod -R a+rX /opt/hf-cache

# Wipe the base image's source tree before copying ours in. COPY only adds
# or overwrites files by name — it never deletes files the base image has
# that we don't — so leftover base-image files (e.g. a paperless/settings/
# package shadowing our paperless/settings.py, or old-numbering migration
# files coexisting with our renumbered ones and corrupting the migration
# graph) would otherwise silently persist alongside/instead of our code.
RUN rm -rf /usr/src/paperless/src

# Copy custom source code (overrides official paperless code)
COPY src/ /usr/src/paperless/src/

# Remove any bytecode cache left over from the base image's build of these
# same modules — without this, a stale .pyc for an overwritten .py file can
# get picked up and cause phantom "attribute doesn't exist" errors at runtime.
RUN find /usr/src/paperless/src -name "__pycache__" -type d -prune -exec rm -rf {} +

# Copy pre-built Angular frontend (en-US + ar-AR)
COPY --from=frontend-builder /frontend-build/ /usr/src/paperless/src/documents/static/frontend/

# Copy production entrypoints
COPY docker/compose/entrypoint-prod.sh    /usr/local/bin/entrypoint-prod.sh
COPY docker/compose/entrypoint-celery.sh      /usr/local/bin/entrypoint-celery.sh
COPY docker/compose/entrypoint-celery-beat.sh /usr/local/bin/entrypoint-celery-beat.sh
RUN chmod +x \
    /usr/local/bin/entrypoint-prod.sh \
    /usr/local/bin/entrypoint-celery.sh \
    /usr/local/bin/entrypoint-celery-beat.sh

WORKDIR /usr/src/paperless
ENTRYPOINT ["/usr/local/bin/entrypoint-prod.sh"]
CMD []
