# ─── Stage 1: Build Angular Frontend ───────────────────────────────────────────
# Build context must be the project root:
#   docker compose -f docker/compose/docker-compose.prod.yml build
FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app
COPY src-ui/ .

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 make g++ pkg-config \
      libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev && \
    rm -rf /var/lib/apt/lists/* && \
    corepack enable && \
    corepack prepare pnpm@10.17.1 --activate && \
    pnpm install --frozen-lockfile && \
    npx ng build --output-path /frontend-build/ --configuration production

# ─── Stage 2: Production Image ─────────────────────────────────────────────────
FROM ghcr.io/paperless-ngx/paperless-ngx:latest

# Install Arabic OCR language pack
RUN apt-get update && \
    apt-get install -y --no-install-recommends tesseract-ocr-ara && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install custom Python packages
RUN pip install --no-cache-dir \
    llama-index-core \
    llama-index-llms-ollama \
    granian

# Copy custom source code (overrides official paperless code)
COPY src/ /usr/src/paperless/src/

# Copy pre-built Angular frontend (en-US + ar-AR)
COPY --from=frontend-builder /frontend-build/ /usr/src/paperless/src/documents/static/frontend/

# Copy production entrypoints
COPY docker/compose/entrypoint-prod.sh    /usr/local/bin/entrypoint-prod.sh
COPY docker/compose/entrypoint-celery.sh      /usr/local/bin/entrypoint-celery.sh
COPY docker/compose/entrypoint-celery-beat.sh /usr/local/bin/entrypoint-celery-beat.sh
RUN chmod +x \
    /usr/local/bin/entrypoint-prod.sh \
    /usr/local/bin/entrypoint-celery.sh \
    /usr/local/bin/entrypoint-celery-beat.sh

WORKDIR /usr/src/paperless
ENTRYPOINT ["/usr/local/bin/entrypoint-prod.sh"]
CMD []
