# syntax=docker/dockerfile:1
# Build context must be the project root:
#   docker compose -f docker/compose/docker-compose.prod.yml build

# Pinned to the upstream release this fork is based on (pyproject.toml version).
# ":latest" drifts: it has already shipped a different ocrmypdf/torch/transformers
# than the ones our code and uv.lock were tested with.
ARG PAPERLESS_BASE=ghcr.io/paperless-ngx/paperless-ngx:2.20.5

# ─── Stage 1: Build Angular Frontend ───────────────────────────────────────────
FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 make g++ pkg-config \
      libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev && \
    rm -rf /var/lib/apt/lists/* && \
    corepack enable && \
    corepack prepare pnpm@10.17.1 --activate

# Install dependencies first, in their own layer, so source-only edits
# (the common case) don't invalidate the pnpm install layer.
COPY src-ui/package.json src-ui/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY src-ui/ .
RUN pnpm exec ng build --output-path /frontend-build/ --configuration production

# ─── Stage 2: Production Image ─────────────────────────────────────────────────
FROM ${PAPERLESS_BASE}

ARG DEBIAN_FRONTEND=noninteractive

# Install Arabic OCR language pack
RUN apt-get update && \
    apt-get install -y --no-install-recommends tesseract-ocr-ara && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Upgrade Arabic, English and orientation/script detection to Tesseract's own
# LSTM "best"-accuracy models. The Debian packages above install the "fast"
# (8-bit) models, tuned for throughput; the float "best" models from the
# tesseract project's own tessdata_best repo score meaningfully higher, and
# the gap matters more for Arabic than for Latin script because of its
# cursive joining and diacritics. OSD (orientation/script detection) backs
# PAPERLESS_OCR_ROTATE_PAGES, so it is upgraded too.
#
# This trades OCR speed for accuracy at ingestion time: the "best" network is
# several times larger and slower to run than "fast". It has no effect on
# chat/search speed, which reads text already extracted and stored in the
# database. Pinned to one commit and checked against a hash computed from
# that exact commit, so what ends up in the image never silently changes
# and a corrupted or substituted download fails the build instead of being
# baked in silently.
#
# Applies only to documents OCR'd from here on; documents already ingested
# keep the text their original OCR pass produced until they are reprocessed
# (per-document "Reprocess", or the bulk "Redo OCR" action).
ARG TESSDATA_BEST_COMMIT=e12c65a915945e4c28e237a9b52bc4a8f39a0cec
RUN set -eu; \
    tessdata_dir=$(dirname "$(find / -xdev -name eng.traineddata 2>/dev/null | head -n1)"); \
    test -n "$tessdata_dir" && test -f "$tessdata_dir/ara.traineddata"; \
    for entry in \
      "ara ab9d157d8e38ca00e7e39c7d5363a5239e053f5b0dbdb3167dde9d8124335896" \
      "eng 8280aed0782fe27257a68ea10fe7ef324ca0f8d85bd2fd145d1c2b560bcb66ba" \
      "osd 9cf5d576fcc47564f11265841e5ca839001e7e6f38ff7f7aacf46d15a96b00ff" \
    ; do \
      set -- $entry; lang=$1; sha=$2; \
      curl -fsSL -o "/tmp/${lang}.traineddata" \
        "https://raw.githubusercontent.com/tesseract-ocr/tessdata_best/${TESSDATA_BEST_COMMIT}/${lang}.traineddata"; \
      echo "${sha}  /tmp/${lang}.traineddata" | sha256sum -c -; \
      mv "/tmp/${lang}.traineddata" "${tessdata_dir}/${lang}.traineddata"; \
    done

# Python dependencies: install exactly what uv.lock pins (the same versions the
# test suite runs against), the way the upstream Dockerfile does. Most of them
# already match the base image, so this only adds/changes the difference.
# torch comes from the CPU index: the default PyPI wheel is built for CUDA and
# drags in ~9GB of nvidia-* libraries the GPU-less server can't use.
COPY pyproject.toml uv.lock /tmp/pydeps/
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /tmp/pydeps && \
    uv export --frozen --quiet --no-dev --all-extras --format requirements-txt \
      --output-file requirements.txt && \
    uv pip install --system --no-python-downloads --python-preference system \
      --index https://pypi.org/simple \
      --index https://download.pytorch.org/whl/cpu \
      --index-strategy unsafe-best-match \
      --requirements requirements.txt && \
    rm -rf /tmp/pydeps

# Bake the embedding models into the image so the first chat question doesn't
# download them, and so they work without outbound access to Hugging Face.
# all-MiniLM-L6-v2 is the app default (English only); the multilingual one
# understands Arabic — switch to it with AI_EMBEDDING_MODEL in .env.prod, then
# rebuild the index (manage.py document_llmindex rebuild).
# HF_HUB_OFFLINE stops every model load from making network calls to the Hub.
# Threads are capped so torch doesn't fight Ollama for the same CPU cores.
ARG EMBEDDING_MODELS="sentence-transformers/all-MiniLM-L6-v2 sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
# llama-index's HuggingFaceEmbedding ignores HF_HOME and loads models from its
# own cache_folder (LLAMA_INDEX_CACHE_DIR), so bake them into that folder —
# otherwise every container start downloads the model again.
ENV HF_HOME=/opt/hf-cache \
    LLAMA_INDEX_CACHE_DIR=/opt/hf-cache/llama_index \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=2
RUN for model in ${EMBEDDING_MODELS}; do \
      python -c "import os, sys; from sentence_transformers import SentenceTransformer; SentenceTransformer(sys.argv[1], cache_folder=os.environ['LLAMA_INDEX_CACHE_DIR'])" "$model" || exit 1; \
    done && \
    chmod -R a+rwX /opt/hf-cache
ENV HF_HUB_OFFLINE=1

# Precompile site-packages. The base image sets PYTHONDONTWRITEBYTECODE, so
# without this every process (each Granian worker, each Celery child) recompiles
# torch/transformers/llama-index on import. Some vendored test files don't
# compile under Python 3, hence "|| true".
RUN python -m compileall -q -j 0 \
      "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" || true

# Wipe the base image's source tree before copying ours in. COPY only adds
# or overwrites files by name — it never deletes files the base image has
# that we don't — so leftover base-image files (e.g. a paperless/settings/
# package shadowing our paperless/settings.py, or old-numbering migration
# files coexisting with our renumbered ones and corrupting the migration
# graph) would otherwise silently persist alongside/instead of our code.
RUN rm -rf /usr/src/paperless/src

# Copy custom source code (overrides official paperless code)
COPY src/ /usr/src/paperless/src/

# Copy pre-built Angular frontend (en-US + ar-AR)
COPY --from=frontend-builder /frontend-build/ /usr/src/paperless/src/documents/static/frontend/

# Build-time steps that the entrypoint used to repeat on every start:
# - drop any __pycache__ that came along, then precompile our own code;
# - compilemessages: .mo files are git-ignored, so without this Django's own
#   Arabic strings (emails, validation errors, admin) fall back to English;
# - collectstatic: gzip/brotli-compressing the two frontend builds takes a
#   while, so do it once here instead of on every webserver start.
WORKDIR /usr/src/paperless/src
RUN find . -name "__pycache__" -type d -prune -exec rm -rf {} + && \
    python -m compileall -q -j 0 . && \
    python manage.py compilemessages --ignore "*/site-packages/*" && \
    python manage.py collectstatic --noinput --clear && \
    chown -R paperless:paperless /usr/src/paperless/static

# Copy production entrypoints
COPY --chmod=0755 docker/compose/entrypoint-prod.sh        /usr/local/bin/entrypoint-prod.sh
COPY --chmod=0755 docker/compose/entrypoint-celery.sh      /usr/local/bin/entrypoint-celery.sh
COPY --chmod=0755 docker/compose/entrypoint-celery-beat.sh /usr/local/bin/entrypoint-celery-beat.sh

# Fail the build (instead of the first request) if an import is broken.
RUN python -c "import django, os; os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'paperless.settings'); django.setup(); import paperless.asgi, paperless_ai.embedding, paperless_tesseract.parsers, ocrmypdf, granian, faiss" && \
    tesseract --list-langs | grep -qx ara && \
    python -c "from llama_index.embeddings.huggingface import HuggingFaceEmbedding as E; assert len(E(model_name='sentence-transformers/all-MiniLM-L6-v2').get_text_embedding('test')) == 384"

WORKDIR /usr/src/paperless
ENTRYPOINT ["/usr/local/bin/entrypoint-prod.sh"]
CMD []
