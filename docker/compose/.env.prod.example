# ─────────────────────────────────────────────────────────────────────────────
# Paperless-ngx Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.prod.example .env.prod
# 2. Edit .env.prod with your actual values
# 3. NEVER commit .env.prod to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string_here

# ── Admin Account ─────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=paperless
DB_PASS=CHANGE_ME_db_password_here
DB_NAME=paperless

# ── Application URL ───────────────────────────────────────────────────────────
# Set this to your Ubuntu machine's IP address or hostname
# Example: http://192.168.1.100:8000
PAPERLESS_URL=http://YOUR_UBUNTU_IP:8000

# Hosts allowed to access the app (comma-separated, no spaces)
# Add your Ubuntu machine's IP address
PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_UBUNTU_IP

# Port to expose on the host
PAPERLESS_PORT=8000

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Riyadh

# ── AI / Ollama ───────────────────────────────────────────────────────────────
AI_ENABLED=yes
AI_BACKEND=ollama
AI_MODEL=qwen2:0.5b

# If Ollama is running on the Ubuntu host machine:
AI_ENDPOINT=http://host.docker.internal:11434

# If Ollama is running as a separate Docker container on the same machine,
# change to: AI_ENDPOINT=http://ollama:11434
# and add an 'ollama' service to docker-compose.prod.yml

# ── Performance ───────────────────────────────────────────────────────────────
# Documents processed in parallel by the celery worker.
TASK_WORKERS=2
# Granian web workers.
GRANIAN_WORKERS=4

# Embedding model for AI chat search. Empty = English-only default.
# Arabic: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# After changing it run:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod exec webserver python src/manage.py document_llmindex rebuild
AI_EMBEDDING_MODEL=
