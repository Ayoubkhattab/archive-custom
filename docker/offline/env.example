# ─────────────────────────────────────────────────────────────────────────────
# Archive settings for a local server (offline bundle)
# ─────────────────────────────────────────────────────────────────────────────
# install.sh copies this to .env on the first run and fills in SECRET_KEY,
# ADMIN_PASSWORD, DB_PASS (random) and the server address. Edit .env, not
# this file, then apply with:  docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string_here

# ── Admin Account ─────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=paperless
DB_PASS=CHANGE_ME_db_password_here
DB_NAME=paperless

# ── Application URL ───────────────────────────────────────────────────────────
# Set this to your Ubuntu machine's IP address or hostname
# Example: http://192.168.1.100:8000
PAPERLESS_URL=http://YOUR_UBUNTU_IP:8000

# Hosts allowed to access the app (comma-separated, no spaces)
# Add your Ubuntu machine's IP address
PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_UBUNTU_IP

# Port to expose on the host
PAPERLESS_PORT=8000

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Riyadh

# ── AI / Ollama ───────────────────────────────────────────────────────────────
AI_ENABLED=yes
AI_BACKEND=ollama
AI_MODEL=gemma4:e4b

# The AI runs in the "ollama" container of this bundle:
AI_ENDPOINT=http://ollama:11434

# If Ollama runs on the host instead: AI_ENDPOINT=http://host.docker.internal:11434

# ── Performance ───────────────────────────────────────────────────────────────
# Documents processed in parallel by the celery worker.
TASK_WORKERS=2
# Granian web workers.
GRANIAN_WORKERS=4

# ── AI speed (CPU server) ─────────────────────────────────────────────────────
# Measure first, on the Ubuntu host:  see ai-speed-check in README.md
# It prints how fast the model reads and writes, and a suggested value below.
#
# Characters of document text sent with a quick question. The model must read
# all of it before the first word: smaller = faster, larger = more context.
AI_FAST_CONTEXT_CHARS=2400
# Longest quick answer, in tokens (~0.1 s each on a CPU).
AI_FAST_MAX_TOKENS=600
# "Ask about this file": documents up to this many characters are sent whole
# and pre-read while the question is typed; longer ones are cut to excerpts.
AI_ASK_MAX_CHARS=8000
# Longer documents: excerpts sent with a quick answer (read while you wait).
AI_ASK_FAST_EXCERPT_CHARS=3000
# CPU priority of OCR below the AI model (0 = equal, 19 = lowest), so answers
# stay fast while documents are being processed.
CELERY_NICE=10

# ── Uploads ───────────────────────────────────────────────────────────────────
# Files over 20 MB are sent from the browser in chunks, 4 at a time. A dropped
# chunk is retried automatically; if the upload still stops (tab closed, long
# outage), selecting the same file again resumes it where it stopped.
#
# Every chunk is one HTTP request, so the reverse proxy in front of the site
# must accept at least this size. nginx, in the server block of the site:
#     client_max_body_size 64m;
#     proxy_request_buffering off;
#     proxy_read_timeout 300s;
#     proxy_send_timeout 300s;
# Cloudflare (free plan) refuses requests over 100 MB: keep this below that.
UPLOAD_CHUNK_SIZE_MB=16
# Largest single file accepted, in GB (0 = no limit). The server needs about
# twice the file's size free while it is uploaded and stored.
UPLOAD_MAX_SIZE_GB=20
# Unfinished uploads are kept (resumable) this long after their last chunk.
UPLOAD_SESSION_EXPIRY_HOURS=72

# ── Arabic OCR ────────────────────────────────────────────────────────────────
# Pages scanned below this resolution are upscaled before OCR: Arabic dots and
# joined letters blur together at low DPI. Empty or 0 turns it off.
OCR_OVERSAMPLE_DPI=300
# Tesseract binarisation: auto (default), otsu, adaptive-otsu or sauvola.
# sauvola copes better with shadows/uneven light in phone photos.
OCR_THRESHOLDING=

# Embedding model for AI chat search. Empty = English-only default.
# Arabic: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# After changing it run:
#   docker compose exec webserver python src/manage.py document_llmindex rebuild
# Recommended for an Arabic archive (already in the image):
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
